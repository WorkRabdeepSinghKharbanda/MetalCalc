VITE_FINNHUB_API_KEY=

# Server-only — no VITE_ prefix, must never be readable from the browser.
# Used by api/send-whatsapp.js (Vercel serverless function).
TWILIO_ACCOUNT_SID=
# Either an API Key pair (below) or TWILIO_AUTH_TOKEN authenticates — API key takes priority if both are set.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Server-only — used by api/send-telegram.js (Vercel serverless function).
# Create a bot via @BotFather on Telegram to get this token.
TELEGRAM_BOT_TOKEN=
